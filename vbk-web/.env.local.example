# --- Firebase klijent (browser) -------------------------------------------
# Firebase konzola -> Project settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vbk-xxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vbk-xxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vbk-xxxxx.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server, API rute i skripte) ---------------------------
# Firebase konzola -> Project settings -> Service accounts -> Generate new private key
# Iz preuzetog JSON-a prepisi project_id, client_email i private_key.
# private_key mora ostati u navodnicima, sa \n umesto stvarnih prelaza reda.
FIREBASE_PROJECT_ID=vbk-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vbk-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Kontakt ---------------------------------------------------------------
NEXT_PUBLIC_EMERGENCY_PHONE="+381 60 000 0000"
